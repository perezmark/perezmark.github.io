  },
];
---

<div class="projects" id="projects">
  <h2 class="heading"><span>Projects</span></h2>
  <div class="project-grid">
    {projects.map((project, index) => (
      <a href={project.link} class="project-card">
        <h3>{project.title}</h3>
        <p>{project.description}</p>
        <div class="tags">
          {project.tags.map(tag => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      </a>
    ))}
  </div>
</div>

<style>
  .projects {
    padding: 6rem 10%;
  }

  .heading {
    text-align: center;
    font-size: 4rem;
    margin-bottom: 3rem;
  }

  .heading span {
    color: var(--heading);
  }

  .project-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    justify-content: center;
    max-width: 1200px;
    margin: 0 auto;
  }

  .project-card {
    flex: 0 1 350px;
    background: var(--secondary);
    background: rgba(26, 27, 38, 0.8);
    backdrop-filter: blur(10px);
    border-radius: 8px;
    padding: 2rem;
    text-decoration: none;
    transition: transform 0.3s ease;
    box-shadow: 0 4px 15px rgba(110, 60, 188, 0.2);
    border: 1px solid rgba(187, 134, 252, 0.1);
  }

  .project-card:hover {
    transform: translateY(-5px);
  }

  .project-card h3 {
    color: var(--heading);
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  .project-card p {
    color: var(--text);
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    background: var(--background);
    color: var(--accent);
  }

  @media (max-width: 768px) {
    .project-card {
      flex: 0 1 300px;
    }
  }
</style>