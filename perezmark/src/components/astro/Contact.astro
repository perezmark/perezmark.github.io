---
import SectionHeading from './SectionHeading.astro';
import { socialLinks, contactEmail } from '../../data/social';
---

<section id="contact" class="py-12 px-6">
  <div class="max-w-2xl mx-auto">
    <SectionHeading title="Contact" />
    <p class="text-sm text-muted-foreground mb-4">
      Reach me at <a href={`mailto:${contactEmail}`} class="text-foreground hover:text-primary transition-colors">{contactEmail}</a>
    </p>
    <div class="flex flex-wrap items-center gap-4">
      {socialLinks.filter(l => l.name !== 'Email').map(link => (
        <a
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-muted-foreground hover:text-foreground transition-colors"
        >
          {link.name}
        </a>
      ))}
    </div>
  </div>
</section>
