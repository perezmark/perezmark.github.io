---
import { socialLinks, contactEmail } from '../../data/social';
---

<section id="home" class="min-h-[60vh] flex items-center pt-14">
  <div class="max-w-2xl mx-auto w-full px-6 py-20">
    <h1 class="text-2xl font-bold text-foreground mb-1">Mark Lester Perez</h1>
    <p class="text-muted-foreground mb-6">Senior DevSecOps Engineer at Capgemini</p>
    <p class="text-muted-foreground leading-relaxed mb-8">
      I build secure, scalable cloud infrastructure. Specialized in
      Kubernetes, GitOps, and Zero Trust architectures across AWS, Azure, and GCP.
    </p>
    <div class="flex flex-wrap items-center gap-4">
      {socialLinks.filter(l => l.name !== 'Email').map(link => (
        <a
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-muted-foreground hover:text-foreground transition-colors"
        >
          {link.name}
        </a>
      ))}
      <a
        href={`mailto:${contactEmail}`}
        class="text-sm text-muted-foreground hover:text-foreground transition-colors"
      >
        Email
      </a>
    </div>
  </div>
</section>
