---
import SectionHeading from './SectionHeading.astro';
import { certifications } from '../../data/certifications';
---

<section id="certifications" class="py-12 px-6">
  <div class="max-w-2xl mx-auto">
    <SectionHeading title="Certifications" />
    <ul class="divide-y divide-border">
      {certifications.map(cert => (
        <li class="py-3 first:pt-0 last:pb-0 flex items-baseline justify-between gap-4">
          <div class="min-w-0">
            <span class="text-sm text-foreground">{cert.name}</span>
            <span class="text-sm text-muted-foreground"> · {cert.issuer}</span>
          </div>
          <span class="text-xs text-muted-foreground flex-shrink-0">{cert.date}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
