---
import SectionHeading from './SectionHeading.astro';
import { certifications } from '../../data/certifications';
---

<section id="certifications" class="py-20 md:py-24 px-4 md:px-8">
  <div class="max-w-6xl mx-auto">
    <SectionHeading title="Certifications" subtitle="Professional certifications and credentials" />
    <div class="grid gap-6 sm:grid-cols-2">
      {certifications.map(cert => (
        <div class="bg-card border border-border rounded-lg p-5 flex items-center gap-4 hover:shadow-sm transition-shadow">
          <div class="w-16 h-16 flex-shrink-0 flex items-center justify-center">
            <img src={cert.logo} alt={cert.name} class="w-14 h-14 object-contain" loading="lazy" />
          </div>
          <div class="flex-1 min-w-0">
            <h3 class="text-sm font-semibold text-foreground leading-snug">{cert.name}</h3>
            <p class="text-xs text-primary mt-1">{cert.issuer}</p>
            <div class="flex items-center gap-2 mt-1.5">
              <span class="text-xs text-muted-foreground">Issued {cert.date}</span>
              {cert.expiry && (
                <span class="text-xs text-muted-foreground">· Expires {cert.expiry}</span>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
