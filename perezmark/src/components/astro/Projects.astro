---
import SectionHeading from './SectionHeading.astro';
import { projects } from '../../data/projects';
---

<section id="projects" class="py-12 px-6">
  <div class="max-w-2xl mx-auto">
    <SectionHeading title="Projects" />
    <ul class="divide-y divide-border">
      {projects.map(project => (
        <li class="py-4 first:pt-0 last:pb-0">
          <a href={project.link} class="group block">
            <span class="text-sm font-medium text-foreground group-hover:text-primary transition-colors">{project.title}</span>
            <span class="text-sm text-muted-foreground"> — {project.description}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
