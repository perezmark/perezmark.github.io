---
const categories = {
  "Cloud Platforms": {
    aws: "https://upload.wikimedia.org/wikipedia/commons/9/93/Amazon_Web_Services_Logo.svg",
    azure: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/azure/azure-original.svg",
    gcp: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/googlecloud/googlecloud-original.svg",
    huawei: "https://upload.wikimedia.org/wikipedia/en/thumb/0/04/Huawei_Standard_logo.svg/252px-Huawei_Standard_logo.svg.png?20190815073546",
    digitalocean: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/digitalocean/digitalocean-original.svg"
  },
  "CI/CD & Version Control": {
    gitlab: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/gitlab/gitlab-original.svg",
    github: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/github/github-original.svg",
    jenkins: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/jenkins/jenkins-original.svg",
    bitbucket: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/bitbucket/bitbucket-original.svg"
  },
  "Containerization & Orchestration": {
    kubernetes: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/kubernetes/kubernetes-plain.svg",
    docker: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/docker/docker-original.svg",
    istio: "https://raw.githubusercontent.com/cncf/artwork/2fedfc0ff2c021e394a53f92e3b1abe133f5939b/projects/istio/icon/color/istio-icon-color.svg",
    cilium: "https://upload.wikimedia.org/wikipedia/commons/thumb/8/8f/Cilium_Logo.svg/382px-Cilium_Logo.svg.png?20230403111557",
    karpenter: "https://raw.githubusercontent.com/aws/karpenter-provider-aws/140ab172190d5a1c53d96fbbbedee94f3ae00a1b/website/static/full_logo.svg",
    helm: "https://helm.sh/img/helm.svg",
    argocd: "https://argo-cd.readthedocs.io/en/stable/assets/logo.png",
    crossplane: "https://raw.githubusercontent.com/crossplane/artwork/ea00e915bc5d2be45ea775fb2bccce772bcba041/logo/icon.svg",
    "cert-manager": "https://raw.githubusercontent.com/cert-manager/cert-manager/98b0bc5872688a89c2bd6f607cccc079baf7f6bf/logo/logo.svg"
  },
  "Infrastructure as Code": {
    terraform: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/terraform/terraform-original.svg",
    terragrunt: "https://seltonfiuza.gallerycdn.vsassets.io/extensions/seltonfiuza/terragrunt-easy-plan/0.1.0/1692128682569/Microsoft.VisualStudio.Services.Icons.Default"
  },
  "Security & Access Management": {
    keycloak: "https://upload.wikimedia.org/wikipedia/commons/thumb/b/b4/Logo_of_Keycloak.svg/1460px-Logo_of_Keycloak.svg.png?20241003094230",
    sonarqube: "https://www.svgrepo.com/show/354365/sonarqube.svg",
    trivy: "https://aquasecurity.github.io/trivy/latest/imgs/logo.png",
    snyk: "https://snyk.io/style/asset/logo/snyk-print.svg"
  },
  "Artifact Management": {
    nexus: "https://upload.wikimedia.org/wikipedia/commons/thumb/e/ef/Logo_of_Sonatype_Nexus_Repository.svg/1334px-Logo_of_Sonatype_Nexus_Repository.svg.png?20240909111743",
    harbor: "https://goharbor.io/img/logos/harbor-icon-color.png"
  },
  "Monitoring & Observability": {
    prometheus: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/prometheus/prometheus-original.svg",
    grafana: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/grafana/grafana-original.svg",
    loki: "https://grafana.com/static/img/logos/logo-loki.svg",
    thanos: "https://raw.githubusercontent.com/thanos-io/thanos/main/docs/img/Thanos-logo_full.svg",
    opentelemetry: "https://opentelemetry.io/img/logos/opentelemetry-horizontal-color.svg",
    promtail: "https://grafana.com/static/img/logos/logo-loki.svg",
    tempo: "https://grafana.com/static/assets/img/logos/grafana-tempo.svg",
    mimir: "https://grafana.com/static/img/logos/logo-mimir.svg",
    alloy: "https://grafana.com/media/docs/alloy/alloy_icon.png"
  },
  "Operating Systems & Web Servers": {
    linux: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/linux/linux-original.svg",
    nginx: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/nginx/nginx-original.svg"
  },
  "Programming & Scripting": {
    python: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/python/python-original.svg",
    bash: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/bash/bash-original.svg",
    javascript: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/javascript/javascript-original.svg",
    go: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/go/go-original-wordmark.svg",
    yaml: "https://upload.wikimedia.org/wikipedia/commons/thumb/5/5a/Official_YAML_Logo.svg/1024px-Official_YAML_Logo.svg.png?20220206165621",
    terraform: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/terraform/terraform-original.svg"
  }
};
---

<div class="tech-stack">
  <h2 class="heading"><span>Tools & Technologies</span></h2>
  {Object.entries(categories).map(([category, tools]) => (
    <div class="category-section">
      <h3>{category}</h3>
      <div class="logo-grid">
        {Object.entries(tools).map(([name, url]) => (
          <div class="logo-item">
            <img src={url} alt={name} title={name} />
            <span class="logo-name">{name}</span>
          </div>
        ))}
      </div>
    </div>
  ))}
</div>

<style>
  .tech-stack {
    padding: 6rem 10%;
  }

  .heading {
    text-align: center;
    width: 100%;
    font-family: 'Orbitron', sans-serif;
    font-size: 3.5rem;
    margin-bottom: 3rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    position: relative;
    display: inline-block;
    background: linear-gradient(45deg, var(--heading) 30%, var(--accent) 70%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .heading span {
    position: relative;
    display: inline-block;
    background: linear-gradient(45deg, var(--accent) 30%, var(--heading) 70%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .category-section {
    margin-bottom: 4rem;
    background: var(--secondary);
    background: rgba(26, 27, 38, 0.8);
    backdrop-filter: blur(10px);
    border-radius: 12px;
    padding: 2rem;
    box-shadow: 0 4px 15px rgba(110, 60, 188, 0.2);
    border: 1px solid rgba(187, 134, 252, 0.1);
  }

  .category-section h3 {
    color: var(--heading);
    font-size: 1.5rem;
    margin-bottom: 2rem;
    text-align: center;
  }

  .logo-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    justify-content: center;
    margin-bottom: 1rem;
    max-width: 1000px;
    margin-left: auto;
    margin-right: auto;
    padding: 0 1rem;
    row-gap: 2rem;
  }

  .logo-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.5rem;
    transition: transform 0.3s ease;
    position: relative;
    width: calc(20% - 1.6rem);
    text-align: center;
    min-width: 120px;
  }

  .logo-item:hover {
    transform: translateY(-5px);
  }

  .logo-item img {
    width: 64px;
    height: 64px;
    object-fit: contain;
    transition: transform 0.3s ease;
  }

  .logo-item:hover img {
    transform: scale(1.1);
  }
  
  @media (max-width: 768px) {
    .logo-item {
      width: calc(33.333% - 1.33rem);
    }
    
    .logo-item img {
      width: 48px;
      height: 48px;
    }
    
    .logo-name {
      font-size: 0.8rem;
    }

    .logo-grid {
      gap: 1rem;
      padding: 0 0.5rem;
    }
  }

  .category-section:has(h3:contains("Monitoring & Observability")) .logo-item img {
    animation: horizontalOrbit 10s linear infinite;
  }

  .category-section:has(h3:contains("Monitoring & Observability")) .logo-item:hover img {
    animation: horizontalOrbit 5s linear infinite;
  }

  @keyframes horizontalOrbit {
    from {
      transform: translateX(-30px);
    }
    50% {
      transform: translateX(30px);
    }
    to {
      transform: translateX(-30px);
    }
  }

  .logo-name {
    font-size: 0.9rem;
    text-transform: uppercase;
    color: var(--text);
  }
</style>