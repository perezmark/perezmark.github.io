---
interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const projects = [
  { path: '/projects/jenkins-pipeline', title: 'Jenkins Pipeline' },
  { path: '/projects/bitbucket-cicd', title: 'Bitbucket CI/CD' },
  { path: '/projects/github-actions', title: 'GitHub Actions' },
  { path: '/projects/eks-terraform', title: 'EKS Infrastructure' },
  { path: '/projects/aks-terraform', title: 'AKS Infrastructure' },
  { path: '/projects/argocd-gitops', title: 'ArgoCD GitOps' },
  { path: '/projects/karpenter-scaling', title: 'Karpenter Scaling' }
];

const currentIndex = projects.findIndex(p => p.path === currentPath);
const prevProject = currentIndex > 0 ? projects[currentIndex - 1] : null;
const nextProject = currentIndex < projects.length - 1 ? projects[currentIndex + 1] : null;
---

<nav class="project-navigation">
  <div class="nav-links">
    {prevProject && (
      <a href={prevProject.path} class="nav-link prev" title={prevProject.title}>
        <i class="bx bx-chevron-left"></i>
        <span class="nav-text">Previous</span>
      </a>
    )}
    <a href="/#projects" class="nav-link home" title="Back to Projects">
      <i class="bx bx-grid-alt"></i>
      <span class="nav-text">Projects</span>
    </a>
    {nextProject && (
      <a href={nextProject.path} class="nav-link next" title={nextProject.title}>
        <span class="nav-text">Next</span>
        <i class="bx bx-chevron-right"></i>
      </a>
    )}
  </div>
</nav>

<style>
  .project-navigation {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 100;
  }

  .nav-links {
    display: flex;
    gap: 0.5rem;
    background: rgba(26, 27, 38, 0.9);
    backdrop-filter: blur(10px);
    padding: 0.5rem;
    border-radius: 12px;
    box-shadow: 0 8px 32px rgba(31, 38, 135, 0.15);
    border: 1px solid rgba(187, 134, 252, 0.1);
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text);
    text-decoration: none;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    transition: all 0.3s ease;
    font-size: 0.9rem;
  }

  .nav-link:hover {
    background: rgba(187, 134, 252, 0.1);
    color: var(--accent);
    transform: translateY(-2px);
  }

  .nav-link i {
    font-size: 1.2rem;
  }

  .nav-text {
    display: none;
  }

  @media (min-width: 768px) {
    .nav-text {
      display: inline;
    }
  }
</style>