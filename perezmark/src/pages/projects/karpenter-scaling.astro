---
import Layout from '../../layouts/Layout.astro';
import ProjectDiagram from '../../components/ProjectDiagram.astro';
import ProjectHeader from '../../components/ProjectHeader.astro';
---

<Layout title="Karpenter Node Scaling - Mark Lester Perez">
  <main class="project-page">
    <ProjectHeader />
    <h1>Karpenter Node Scaling</h1>
    
    <section class="overview">
      <h2>Project Overview</h2>
      <p>
        Implementation of efficient node scaling in Kubernetes clusters using Karpenter,
        providing just-in-time node provisioning and optimized resource utilization.
      </p>
    </section>

    <section class="technologies">
      <h2>Technologies Used</h2>
      <ul>
        <li>Karpenter</li>
        <li>AWS EKS</li>
        <li>EC2 Spot Instances</li>
        <li>CloudWatch</li>
        <li>Prometheus</li>
        <li>Grafana</li>
      </ul>
    </section>

    <section class="implementation">
      <h2>Implementation Details</h2>
      
      <h3>Scaling Configuration</h3>
      <ul>
        <li>Custom provisioner configurations</li>
        <li>Node template definitions</li>
        <li>Instance type diversity</li>
        <li>Spot instance integration</li>
        <li>Resource limits and constraints</li>
      </ul>

      <h3>Optimization Features</h3>
      <ul>
        <li>Bin packing efficiency</li>
        <li>Cost optimization strategies</li>
        <li>Workload consolidation</li>
        <li>Resource utilization improvements</li>
        <li>Scaling performance metrics</li>
      </ul>

      <h3>Monitoring Setup</h3>
      <ul>
        <li>Scaling metrics collection</li>
        <li>Performance monitoring</li>
        <li>Cost tracking</li>
        <li>Custom dashboards</li>
        <li>Alerting configuration</li>
      </ul>
    </section>

    <section class="architecture">
      <h2>Architecture Diagram</h2>
      <ProjectDiagram type="karpenter" />
    </section>

    <section class="architecture">
      <h2>Architecture Overview</h2>
      <p>
        The Karpenter implementation provides efficient cluster scaling with:
      </p>
      <ul>
        <li>Just-in-time node provisioning</li>
        <li>Multi-architecture support</li>
        <li>Spot instance management</li>
        <li>Automated node cleanup</li>
        <li>Integration with cluster autoscaler</li>
      </ul>
    </section>
  </main>
</Layout>

<style>
  .project-page {
    max-width: 800px;
    margin: 0 auto;
    padding: 6rem 2rem;
  }

  h1 {
    font-size: 3rem;
    color: var(--heading);
    margin-bottom: 2rem;
  }

  section {
    margin-bottom: 3rem;
  }

  h2 {
    color: var(--accent);
    font-size: 1.8rem;
    margin-bottom: 1rem;
  }

  h3 {
    color: var(--heading);
    font-size: 1.4rem;
    margin: 1.5rem 0 1rem;
  }

  p {
    color: var(--text);
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  ul {
    list-style-type: none;
    padding: 0;
  }

  li {
    color: var(--text);
    margin-bottom: 0.5rem;
    padding-left: 1.5rem;
    position: relative;
  }

  li::before {
    content: "•";
    color: var(--accent);
    position: absolute;
    left: 0;
  }
</style>