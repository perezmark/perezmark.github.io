---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/astro/Header.astro';
import Footer from '../../components/astro/Footer.astro';
import { projects } from '../../data/projects';
---

<Layout title="Projects - Mark Lester Perez">
  <Header />
  <main class="pt-24 pb-16 px-4 md:px-8">
    <div class="max-w-6xl mx-auto">
      <div class="mb-10">
        <h1 class="text-3xl md:text-4xl font-bold text-foreground">Projects</h1>
        <p class="text-muted-foreground mt-2">Selected work and implementations</p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2">
        {projects.map(project => (
          <a href={project.link} class="group block bg-card border border-border rounded-lg p-6 hover:shadow-sm transition-all">
            <h3 class="text-lg font-semibold text-foreground mb-2 group-hover:text-primary transition-colors">
              {project.title}
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline ml-1 opacity-0 group-hover:opacity-100 transition-opacity"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </h3>
            <p class="text-sm text-muted-foreground mb-4 leading-relaxed">{project.description}</p>
            <div class="flex flex-wrap gap-1.5">
              {project.tags.map(tag => (
                <span class="inline-flex items-center rounded-md border border-border bg-secondary px-2 py-0.5 text-xs text-muted-foreground">
                  {tag}
                </span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</Layout>
