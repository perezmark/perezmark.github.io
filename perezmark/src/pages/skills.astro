---
import Layout from '../layouts/Layout.astro';
import Header from '../components/astro/Header.astro';
import Footer from '../components/astro/Footer.astro';
import { techStack } from '../data/techstack';
---

<Layout title="Skills - Mark Lester Perez">
  <Header />
  <main class="pt-24 pb-16 px-4 md:px-8">
    <div class="max-w-6xl mx-auto">
      <div class="mb-10">
        <h1 class="text-3xl md:text-4xl font-bold text-foreground">Tools & Technologies</h1>
        <p class="text-muted-foreground mt-2">Technologies I work with regularly</p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {techStack.map(category => (
          <div class="bg-card border border-border rounded-lg p-6">
            <h3 class="text-sm font-semibold text-foreground mb-4 uppercase tracking-wider">{category.name}</h3>
            <div class="flex flex-wrap gap-4">
              {category.tools.map(tool => (
                <div class="flex flex-col items-center gap-1.5 group" title={tool.name}>
                  <div class="w-12 h-12 flex items-center justify-center rounded-md bg-secondary/50 group-hover:bg-secondary transition-colors p-2">
                    <img src={tool.logo} alt={tool.name} class="w-8 h-8 object-contain" loading="lazy" />
                  </div>
                  <span class="text-[10px] text-muted-foreground uppercase tracking-wide">{tool.name}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</Layout>
