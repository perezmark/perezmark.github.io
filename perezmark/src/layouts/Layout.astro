---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Astro description" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
		<link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet' />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
<style is:global>
	:root {
		--primary: #E2E8F0;
		--secondary: #1A1B26;
		--accent: #F8FAFC;
		--text: #A9B1D6;
		--heading: #F5F5F7;
		--background: #13141F;
	}
	html {
		font-family: 'Space Grotesk', system-ui, sans-serif;
		background: var(--background);
		scroll-behavior: smooth;
		background: linear-gradient(to bottom, #13141F, #1A1B26);
		background-attachment: fixed;
	}
	code {
		font-family:
			'JetBrains Mono',
			monospace;
	}
	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
		-webkit-tap-highlight-color: transparent;
	}
	body {
		color: var(--text);
		background: var(--background);
		background: linear-gradient(to bottom, #13141F, #1A1B26);
		background-attachment: fixed;
		position: relative;
		overflow-x: hidden;
	}
	
	body::before {
		content: '';
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
		background-image: 
			radial-gradient(white, rgba(255,255,255,.2) 2px, transparent 3px),
			radial-gradient(white, rgba(255,255,255,.15) 1px, transparent 2px),
			radial-gradient(white, rgba(255,255,255,.1) 1px, transparent 2px);
		background-size: 550px 550px, 350px 350px, 250px 250px;
		background-position: 0 0, 40px 60px, 130px 270px;
		animation: stars 120s linear infinite;
	}

	@media (max-width: 768px) {
		body::before {
			background-size: 275px 275px, 175px 175px, 125px 125px;
		}
	}
	
	@keyframes stars {
		0% {
			transform: rotate(0deg);
		}
		100% {
			transform: rotate(360deg);
		}
	}
	.btn {
		position: relative;
		display: inline-flex;
		justify-content: center;
		align-items: center;
		width: 150px;
		height: 100%;
		background: var(--accent);
		border: none;
		border-radius: 8px;
		font-size: 19px;
		color: var(--heading);
		text-decoration: none;
		font-weight: 500;
		letter-spacing: 1px;
		z-index: 1;
		overflow: hidden;
		transition: .5s;
	}
	.btn:hover {
		color: #fff;
	}
	.btn::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		width: 0;
		height: 100%;
		background: var(--primary);
		z-index: -1;
		transition: .5s;
	}
	.btn:hover::before {
		width: 100%;
	}
</style>